# Template only — do not put real keys in this file (it IS committed).
# `npm run dev` (or `npm run setup:env`) copies it to .env, which is git-ignored:
# paste your real keys into .env. Every key is optional: a missing key switches
# that integration to its local mock/fallback mode.

# --- Claude (in-app agent) -------------------------------------------------
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (cheap, default) | claude-sonnet-5-5 (richer answers for demo day)
ANTHROPIC_MODEL=claude-haiku-5-5

# --- TypeSafe Jev (typed guardrails + categorisation) ----------------------
TYPESAFE_API_KEY=
# (legacy whole-reply check, kept for the standalone /api/jev/verify route docs; the agent now uses JEV_CLAIM_THRESHOLD below)
JEV_HALLUCINATION_THRESHOLD=0.3
# Claim-level citation check: a reply sentence is "unsupported" (and gets removed/fixed) when Jev's probability that its
# cited evidence supports every figure, date and merchant in it falls below this (0..1)
JEV_CLAIM_THRESHOLD=0.6

# --- PayPal Sandbox (APIMatic-generated @paypal/paypal-server-sdk) ---------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | production
PAYPAL_ENVIRONMENT=sandbox
# true = serve src/lib/mock-data.ts instead of calling the Sandbox
PAYPAL_USE_MOCK=true

# --- Zapier (low-balance alerts) -------------------------------------------
# Catch Hook URL from a "Webhooks by Zapier" trigger, e.g. https://hooks.zapier.com/hooks/catch/123/abc/
ZAPIER_WEBHOOK_URL=

# --- Kernel (cloud browser for merchant-site subscription cancellations) ----
KERNEL_API_KEY=
# Saved Kernel browser profile holding the user's merchant logins
KERNEL_PROFILE_NAME=pfm-demo
# sandbox (default) = Kernel cancels the FAKE subscriptions on our own sandbox merchant pages (/demo-merchant/<id>)
# and clicks through to "cancelled". real = old path: real merchant sites + saved profile, stops BEFORE the final click.
KERNEL_TARGET=sandbox
# Optional public URL of this app (ngrok / cloudflared tunnel, no trailing slash). When set, the Kernel browser
# opens PUBLIC_BASE_URL/demo-merchant/<id> (real address bar); when empty the page is injected with setContent().
PUBLIC_BASE_URL=
# Optional: seconds to keep the sandbox browser alive after the run so live view/replay stay watchable (default 90)
# KERNEL_CLEANUP_GRACE_S=90
